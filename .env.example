# Copy this file to .env for local development with `vercel dev`.
# Never commit the real .env file -- see .gitignore.

# Required: your Anthropic API key. Used only server-side, inside
# api/generate-guide.js. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the Claude model used for live generation.
# Defaults to claude-opus-5 if unset. See README.md "Model choice"
# for the tradeoffs of changing this (e.g. a cheaper/faster model
# for high-volume or cost-sensitive deployments).
# ANTHROPIC_MODEL=claude-opus-5
